PORT=5000
NODE_ENV=development
MONGODB_URI=
JWT_SECRET=
CLIENT_URL=http://localhost:5173
# Optional: the first registered user becomes Admin only if this is "true"
FIRST_USER_ADMIN=true

# Optional: DNS servers used when MONGODB_URI is mongodb+srv:// (fixes "querySrv ECONNREFUSED" on some networks)
# DNS_SERVERS=8.8.8.8,1.1.1.1

# Email (password-reset links and the Messages page). Without SMTP_HOST + SMTP_FROM the app still runs;
# sending is simply reported as "not configured" and nothing is claimed as sent.
SMTP_HOST=
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# The ONLY From address ever used. Must be allowed by your SMTP provider, e.g. Orbitask <no-reply@yourdomain.com>
SMTP_FROM=
